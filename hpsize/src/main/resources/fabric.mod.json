{
	"schemaVersion": 1,
	"id": "hpsize",
	"version": "${version}",
	"name": "HP Size",
	"description": "Every mob is as big as its health: 20 HP is normal size, a chicken is tiny and an iron golem is a giant. Every hit shrinks the mob. Includes commands that make recording videos easier.",
	"authors": [
		"pikczu77"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/hpsize",
		"sources": "https://github.com/pikczu77/plugins",
		"issues": "https://github.com/pikczu77/plugins/issues"
	},
	"license": "MIT",
	"icon": "assets/hpsize/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.pikczu77.hpsize.HpSize"
		],
		"client": [
			"io.github.pikczu77.hpsize.client.HpSizeClient"
		]
	},
	"mixins": [
		"hpsize.mixins.json",
		{
			"config": "hpsize.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
